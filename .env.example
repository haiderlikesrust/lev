# Copy to .env.local. With no .env at all the app runs in practice mode: play money, mocked
# Collector Crypt purchases drawn from a real CC pull sample, and an embedded database.

# ── Server ────────────────────────────────────────────────────────────────
# true turns on real signing and spending. Keep false until `npm run check` is all green.
MAINNET_ENABLED=false
# The exact public URL people open (scheme + host, no trailing slash). POSTs from other origins are refused.
APP_ORIGIN=http://localhost:3000
# Postgres for production. Without it the app uses embedded Postgres in .data/ (one process, local only).
# DATABASE_URL=postgres://user:password@host:5432/crypt_leverage
# The wallet that can open /admin.
OWNER_WALLET=

# ── Wallets (server only: never in a NEXT_PUBLIC_ variable, never committed) ─
# Base58 secret key or a JSON array of 64 bytes. They must be different wallets, and different from Pullback's.
# LEV_OPS: receives pack payments, buys and opens packs on CC, holds cards for seconds, sells losers back.
# Needs SOL for fees and a USDC token account.
LEV_OPS_PRIVATE_KEY=
# LEV_POOL: the leverage pool's USDC. Receives sellbacks and the 15% fee split; pays bonuses and floors.
LEV_POOL_PRIVATE_KEY=
# The wallet that claims our coin's creator fees and sends their USDC to LEV_POOL with memo `fee-split:<cycle>`.
# Only its transfers count as fee income; the split between pool and owner buyback is set in /admin.
FEE_SOURCE_WALLET=
# Our coin's mint, and a Jupiter API key (portal.jup.ag) for the owner's buyback swap.
MEMECOIN_MINT=
JUPITER_API_KEY=

# ── Providers ─────────────────────────────────────────────────────────────
# A paid mainnet RPC (Helius, Triton, QuickNode). Must support DAS getAsset for card names/images.
SOLANA_RPC_URL=
DAS_RPC_URL=
# Ask Collector Crypt on Discord. Without it packs carry the generic `cc-` memo prefix.
COLLECTOR_CRYPT_API_KEY=
# Devnet: https://dev-gacha.collectorcrypt.com (use devnet USDC and SOLANA_CLUSTER=devnet with it).
COLLECTOR_CRYPT_BASE_URL=https://gacha.collectorcrypt.com
# CC's gacha wallet (docs.collectorcrypt.com/gacha/vrf). Confirm with CC before launch.
COLLECTOR_CRYPT_PAYMENT_WALLET=GachaNgyXTU3zFogQ8Z5jR2BLXs8215X2AtEH18VxJq3
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
SOLANA_CLUSTER=

# ── Defaults you normally keep ────────────────────────────────────────────
PRIORITY_MICRO_LAMPORTS=50000
WORKER_ENABLED=true
# Practice mode with CC's live machines and pull feed instead of the saved sample.
PRACTICE_LIVE_DATA=false
