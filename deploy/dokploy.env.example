# Paste into the application's Environment tab in Dokploy. Do not commit filled-in values.
# The exact public origin people open, with no trailing slash. Sign-in messages and the origin check on every write use it.
APP_ORIGIN=https://long.cards
# The Internal Connection URL of the Postgres service you create in Dokploy (docs/DOKPLOY.md, step 1).
DATABASE_URL=
# Keep false until `npm run check` is all green and the wallets are funded. false is a public practice site with play money.
MAINNET_ENABLED=false
# Practice mode only: true uses CC's live machines and pull feed instead of the saved sample.
PRACTICE_LIVE_DATA=true
# The wallet that can open /admin.
OWNER_WALLET=

# Two different wallets, both different from Pullback's. Base58 secret key, or a quoted JSON array of 64 bytes.
LEV_OPS_PRIVATE_KEY=
LEV_POOL_PRIVATE_KEY=
# The wallet that sends the creator-fee USDC to LEV_POOL with memo `fee-split:<cycle>`.
FEE_SOURCE_WALLET=
# Our coin's mint, shown on the site as the contract address, and its ticker without the $ (e.g. LONG).
MEMECOIN_MINT=
COIN_TICKER=
JUPITER_API_KEY=

# A paid mainnet RPC (Helius, Triton, QuickNode) that supports DAS getAsset.
SOLANA_RPC_URL=
DAS_RPC_URL=
COLLECTOR_CRYPT_API_KEY=
COLLECTOR_CRYPT_BASE_URL=https://gacha.collectorcrypt.com
COLLECTOR_CRYPT_PAYMENT_WALLET=GachaNgyXTU3zFogQ8Z5jR2BLXs8215X2AtEH18VxJq3
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
SOLANA_CLUSTER=
PRIORITY_MICRO_LAMPORTS=50000
WORKER_ENABLED=true
